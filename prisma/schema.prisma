// ChatWise database schema — the source of truth for the data model.
// See docs/Architecture.md §4 for the high-level entity list.
//
// Phase 0 defined the two base tables: User (who logs in) and Business (the
// company that user runs). Phase 1 added the tables NextAuth needs to remember
// logins. Phase 3 adds the account's single agent and its single WhatsApp
// connection. Later phases add the conversation, lead, campaign and billing
// tables.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The connection string is read from DATABASE_URL via prisma7.config.ts,
  // never hardcoded here (docs/Rules.md §3).
}

/// A person who signs up for ChatWise. One user owns one business.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  /// Set once the person has confirmed their email address. Google sign-ins
  /// arrive already verified.
  emailVerified DateTime?
  /// Hashed password — never the password itself (docs/Rules.md §3).
  /// Null for accounts that only sign in with Google.
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business Business?
  accounts Account[]
  sessions Session[]

  /// Which team this person works in (see BusinessMember). The owner has a row
  /// here too, so "who may see this business" is one lookup for everybody.
  membership  BusinessMember?
  invitesSent TeamInvite[]

  @@map("users")
}

// ─── Tables NextAuth needs ──────────────────────────────────────────────────
// The three models below are NextAuth's, and their field names are fixed by it
// — including the snake_case ones, which come from the OAuth spec. Don't rename
// them.

/// Links a user to a sign-in provider they used, e.g. their Google account.
/// A user signing in with email and password has no row here.
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// A signed-in browser session. ChatWise keeps sessions in an encrypted cookie
/// rather than in this table (see lib/auth.ts), but NextAuth's Prisma adapter
/// requires the table to exist.
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Short-lived tokens for email verification and password-reset links.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

/// The business profile collected during onboarding (docs/PRD.md §3, Step C).
/// Exactly one business per user account — the one-setup-per-account rule in
/// docs/PRD.md §3.1 hangs off this row.
model Business {
  id     String @id @default(cuid())
  /// Unique: an account has exactly one business.
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Null until setup Step C, because the row is created when someone starts
  /// the wizard — before we've asked them anything.
  name                  String?
  industry              String?
  /// Free-text description of what the business sells or does.
  about                 String?
  timezone              String    @default("UTC")
  /// Set when the wizard is finished. Null means setup is still in progress,
  /// which is what sends someone back into it.
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  /// The business's own Gemini API key, AES-256-GCM ciphertext (see
  /// lib/encryption.ts). Null means "use the platform's own GEMINI_API_KEY".
  /// Never sent to the browser — Settings only ever says whether one is set.
  geminiApiKey Bytes?

  /// Privacy: shows the contact's number to whoever is reading the inbox only
  /// in masked form (e.g. "+91••••••789"), rather than in full. Off by
  /// default, because most accounts are a single owner who already knows
  /// their own customers' numbers.
  maskContactPhone Boolean @default(false)

  agent            AgentInstance?
  connection       WhatsAppConnection?
  conversations    Conversation[]
  knowledgeEntries KnowledgeEntry[]
  leads            Lead[]
  templates        MessageTemplate[]
  campaigns        Campaign[]
  optOuts          OptOut[]
  subscription     Subscription?
  quickReplies     QuickReply[]
  businessHours    BusinessHours?

  // ── CRM & integrations (2026-09-26) ──
  members            BusinessMember[]
  invites            TeamInvite[]
  contacts           Contact[]
  tags               Tag[]
  consentEvents      ConsentEvent[]
  jobs               PendingJob[]
  tagRules           TagRule[]
  segments           Segment[]
  deals              Deal[]
  dealActivities     DealActivity[]
  notes              ConversationNote[]
  notifications      Notification[]
  complianceRequests ComplianceRequest[]
  shop               Shop?
  orders             Order[]
  checkouts          ShopifyCheckout[]
  payments           Payment[]
  paymentAccounts    PaymentAccount[]
  automations        AutomationSetting[]
  google             GoogleConnection?
  scheduledExports   ScheduledExport[]
  importBatches      ImportBatch[]
  calendly           CalendlyConnection?
  bookings           Booking[]
  products           Product[]

  /// When the AI flags an inbound message as urgent or angry, stop the agent
  /// and hand the thread to a person instead of letting the bot answer it.
  escalateUrgentToHuman Boolean @default(false)

  @@map("businesses")
}

// ─── The one-setup-per-account rule ─────────────────────────────────────────
// docs/PRD.md §3.1 and docs/Rules.md §6: an account runs exactly one agent on
// exactly one connection type. Both models below key off `businessId` with a
// UNIQUE constraint, so a second row is rejected by PostgreSQL itself — not
// merely discouraged by the screens. Switching agent or connection updates the
// single row; it never adds a second.

/// Which agents a customer can choose. Kept in step with /bots — every value
/// here has a folder there.
///
/// There is deliberately no CRM value: the CRM agent runs in the background
/// alongside the chosen agent and is never a selectable option, so it must
/// never be stored as one.
enum BotType {
  RECEPTIONIST
  LEAD_QUALIFIER
  APPOINTMENT
  SALES
  SUPPORT
  FOLLOW_UP
  PERSONAL_SHOPPER
  FEEDBACK
  INTERNAL
}

/// How an account is connected to WhatsApp.
///
/// Both tiers are paid; they differ in who the customer is and who else bills
/// them. See whatsapp-connectors/capabilities.ts for what each one can do.
enum ConnectionType {
  /// For small businesses — the customer scans a QR code, like WhatsApp Web.
  /// The platform subscription is the whole bill; nothing is charged per message.
  QR
  /// For larger businesses — the official WhatsApp Business Cloud API. The
  /// platform subscription *plus* Meta's own per-conversation charges, billed by
  /// Meta directly to the customer. We never see that money and never quote a
  /// rate for it (docs/Rules.md §9).
  API
}

enum ConnectionStatus {
  NOT_CONNECTED
  CONNECTING
  CONNECTED
  RECONNECTING
  DISCONNECTED
  ERROR
}

/// The single agent this business runs.
model AgentInstance {
  id         String   @id @default(cuid())
  /// UNIQUE — one agent per business, enforced by the database.
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  botType BotType

  /// The answers to that agent's own setup questions, keyed by question id.
  /// The questions themselves live in /bots/<agent>/config-schema.ts, so this
  /// stays correct as agents gain or lose questions.
  config Json @default("{}")

  // ── How it should behave (setup Step D) ──
  /// How it should come across, e.g. "friendly", "formal".
  tone            String?
  /// The language it replies in.
  language        String?
  /// When it should stop and fetch a person. Every agent must have a way out
  /// to a human (docs/Rules.md §5).
  escalationRules String?
  /// Who the customer is handed to, in words the end customer will see.
  escalateTo      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agent_instances")
}

/// The single WhatsApp connection this business uses. Either QR or API, never
/// both — one row, and `type` holds the choice.
model WhatsAppConnection {
  id         String   @id @default(cuid())
  /// UNIQUE — one connection per business, enforced by the database.
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  type   ConnectionType
  status ConnectionStatus @default(NOT_CONNECTED)

  /// The connected number, once there is one. Shown in the dashboard.
  phoneNumber String?

  /// Nothing secret lives on this row. The session itself is encrypted and
  /// kept in WhatsAppSession; API credentials arrive in Phase 6
  /// (docs/Rules.md §3).
  lastConnectedAt DateTime?
  /// The last failure, in words a customer can act on — never a stack trace.
  lastError       String?

  /// Proof the pipe works, and the basis of the health indicator. Counting is
  /// deliberate: we record that a message arrived, not what it said
  /// (docs/Rules.md §4 — don't log customers' private conversations).
  messagesReceived Int       @default(0)
  messagesSent     Int       @default(0)
  lastMessageAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session     WhatsAppSession?
  credentials WhatsAppApiCredential?

  @@map("whatsapp_connections")
}

/// The saved WhatsApp Web session for a QR-tier connection — what lets a
/// customer stay connected without rescanning the QR code every time.
///
/// This is effectively a key to that business's WhatsApp account, so it is
/// stored encrypted and never leaves the server (docs/Rules.md §3). The app
/// itself never reads it; only the worker that owns that customer's session
/// does.
model WhatsAppSession {
  id           String             @id @default(cuid())
  /// UNIQUE — one saved session per connection.
  connectionId String             @unique
  connection   WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  /// AES-256-GCM ciphertext (see lib/encryption.ts). Never plain text.
  data Bytes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("whatsapp_sessions")
}

/// The Meta credentials for an API-tier connection.
///
/// Every customer brings their **own** Meta app, so everything here belongs to
/// that one customer — including the app secret. Nothing about Meta is
/// configured platform-wide.
///
/// The access token and app secret are both keys to that business's WhatsApp,
/// so both are encrypted and never leave the server (docs/Rules.md §3). Neither
/// is ever sent to the browser, not even masked; the screen is told only
/// *whether* credentials are saved.
model WhatsAppApiCredential {
  id           String             @id @default(cuid())
  /// UNIQUE — one set of credentials per connection.
  connectionId String             @unique
  connection   WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  /// Meta's id for the business phone number.
  ///
  /// UNIQUE across every account: it is what says whose message an inbound
  /// webhook is. Two accounts claiming the same number would make that
  /// ambiguous.
  phoneNumberId String @unique

  /// The customer's Meta app id. Not secret — useful for support.
  appId String?

  /// The WhatsApp Business Account the number belongs to. Optional.
  businessAccountId String?

  /// The human-readable number, for showing on the dashboard. Not a secret.
  displayPhoneNumber String?

  /// AES-256-GCM ciphertext of the access token (see lib/encryption.ts).
  accessToken Bytes

  /// AES-256-GCM ciphertext of that customer's Meta app secret.
  ///
  /// Meta signs every webhook with this, and each customer's app has its own.
  /// Without it, no inbound message from this customer can be verified — and an
  /// unverifiable message is refused, never trusted.
  appSecret Bytes

  /// The random segment in this customer's own webhook address.
  ///
  /// Each customer gets a distinct URL, which is what lets us know whose
  /// payload we are looking at *before* verifying it. That matters because
  /// Meta's initial verification call carries no phone number — only a token
  /// and a challenge — so the path is the only thing identifying the account.
  webhookPathToken String @unique

  /// The token the customer pastes into Meta's "Verify token" box. We generate
  /// it so it is strong and so there is one less thing for them to invent.
  webhookVerifyToken String

  /// Set when we last successfully called Meta with these credentials.
  verifiedAt        DateTime?
  /// Set the first time Meta completed the webhook handshake against this URL.
  webhookVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("whatsapp_api_credentials")
}

// ─── Phase 7: conversations, messages and the knowledge base ────────────────
// Up to this point nothing stored what a message actually said — deliberately,
// because there was nowhere for it to go and no reason to keep somebody's
// private conversation (docs/Rules.md §4). Phase 7 changes that: a bot cannot
// answer a question it is not allowed to read, and the customer is promised an
// inbox they can look at (docs/PRD.md §6). So message text is stored from here
// on, and the rule becomes "keep it where the business that owns it can see it,
// and nowhere else" — not the server logs, not the queue payloads that pass
// through our own infrastructure.

/// Who stopped the agent replying in a thread (Phase 9).
///
/// Worth telling apart even though the effect is identical, because the two
/// mean opposite things to the person reading the inbox: one is the agent
/// asking for help, the other is that person having already stepped in.
enum HandoverSource {
  /// The agent handed the thread over — it could not answer, or the owner's
  /// escalation rules said to fetch somebody.
  AGENT
  /// Somebody at the business took the thread over from the inbox, either by
  /// pressing Take over or simply by typing a reply themselves.
  HUMAN
}

/// One WhatsApp thread, between a business and one of its customers.
///
/// Keyed on the contact's phone number, which is the only identity WhatsApp
/// gives us. One row per contact per business — so a customer who messages
/// again in a month lands back in the same thread rather than starting a new
/// one.
model Conversation {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// The customer's number, digits only, in international format.
  contactPhone String
  /// Whatever name WhatsApp gives us for them, if any. Not to be trusted as
  /// identity — it is whatever they set on their own phone.
  contactName  String?

  /// When anything last happened, so the inbox can sort by it without counting
  /// messages.
  lastMessageAt DateTime @default(now())

  /// Set while the agent is not replying in this thread — either because it
  /// handed over itself (docs/Rules.md §5 — every agent needs a way out) or
  /// because somebody at the business took the thread over from the inbox
  /// (Phase 9). Cleared when they let the agent carry on.
  ///
  /// The router treats this one field as "stay quiet", whichever of the two put
  /// it there, so there is only ever one thing to check before replying.
  escalatedAt      DateTime?
  /// Which of the two it was. Null whenever `escalatedAt` is null.
  escalatedBy      HandoverSource?
  /// Why it stopped, in words the business owner can act on.
  escalationReason String?

  /// How many of this contact's messages have arrived since somebody at the
  /// business last opened the thread.
  ///
  /// A stored count rather than a "messages after your last visit" query,
  /// because the inbox lists a hundred threads at a time and that query would
  /// be a hundred more (docs/Rules.md §4 — the dashboard has to stay quick to
  /// be worth watching).
  unreadCount Int @default(0)

  /// Short labels a person put on this thread, e.g. "vip", "billing
  /// question". Free text, not tied to any other list — the inbox filters and
  /// exports by whatever is actually here.
  tags String[] @default([])

  /// A person's own notes about this thread — visible only inside this
  /// account, never sent to the customer. Distinct from `Lead.notes`: a
  /// conversation exists before any lead does, so this is always available.
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The CRM contact this thread belongs to. Nullable only so that rows
  /// written before contacts existed still load; every new thread gets one.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// The team member handling this thread, if anyone is.
  assignedToId String?
  assignedTo   BusinessMember? @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  /// Raised when the AI reads a message as angry or urgent, so the inbox can
  /// put it first. Cleared by a person.
  priority       ConversationPriority @default(NORMAL)
  priorityReason String?

  /// A few sentences for whoever picks the thread up: the last topic, what is
  /// still unanswered, and how the customer seems. Written by the AI on
  /// handover and every so often after that.
  summary             String?   @db.Text
  summaryUpdatedAt    DateTime?
  /// How many messages the thread had when `summary` was written.
  summaryMessageCount Int       @default(0)

  messages         Message[]
  internalNotes    ConversationNote[]
  /// The CRM record the background agent keeps up to date (Phase 8).
  lead             Lead?
  /// Any bulk messages sent to this contact (Phase 12).
  campaignMessages CampaignRecipient[]

  /// One thread per contact, enforced by the database rather than by whichever
  /// code path happens to create it.
  @@unique([businessId, contactPhone])
  @@index([businessId, lastMessageAt])
  @@index([contactId])
  @@index([businessId, assignedToId])
  @@index([businessId, priority])
  @@map("conversations")
}

enum MessageDirection {
  /// From the customer to the business.
  INBOUND
  /// From the business to the customer.
  OUTBOUND
}

/// Who wrote a message.
enum MessageAuthor {
  /// The end customer messaging the business.
  CONTACT
  /// One of the agents in /bots.
  AGENT
  /// A person at the business, typing in the inbox (Phase 9).
  HUMAN
  /// Something ChatWise itself said, e.g. an apology when the agent failed.
  SYSTEM
  /// One of a bulk send's messages (Phase 12). Kept apart from HUMAN because a
  /// broadcast is not somebody answering a customer, and counting it as one
  /// would flatter both the reply figures and the answer times.
  CAMPAIGN
  /// An automated message the business switched on: an order confirmation, a
  /// payment receipt, a booking reminder (2026-09-26). Not an answer to
  /// anybody, for the same reason as CAMPAIGN.
  AUTOMATION
}

/// A single WhatsApp message in a thread.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction MessageDirection
  author    MessageAuthor

  /// What was actually said. Visible to the business that owns the thread and
  /// to nobody else — never written to a log (docs/Rules.md §4).
  body String @db.Text

  /// Which agent produced this reply, for the per-agent breakdown in Analytics.
  /// Null for anything a person or a customer wrote.
  botType BotType?

  /// The id WhatsApp or Meta gave this message.
  ///
  /// UNIQUE because Meta re-sends a webhook it thinks we missed, and a retry
  /// must not turn into a second copy of the same message — or a second reply
  /// to the customer. A repeat insert fails and the retry is dropped.
  externalId String? @unique

  /// Set when sending failed, in words a person can act on.
  failureReason String?

  /// How the customer came across in this message, read by the AI after it
  /// arrived. Null for outbound messages and for anything not yet read.
  sentiment Sentiment?
  /// True when the AI thought this needs a person soon.
  urgent    Boolean    @default(false)
  /// The team member who typed it, for messages written in the inbox.
  sentById  String?
  /// The language it was written in, as a short code ("en", "hi").
  language  String?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// One question-and-answer pair the agent may answer from.
///
/// This is the whole of the Phase 7 knowledge base: plain question/answer text
/// a non-technical owner types in (docs/PRD.md §6). Catalogues and uploads come
/// later. An agent answers from these and from the setup answers, and from
/// nothing else — if it isn't here, it says so rather than inventing one
/// (docs/Rules.md §5).
model KnowledgeEntry {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  question String @db.Text
  answer   String @db.Text

  /// The order the owner arranged them in.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, position])
  @@map("knowledge_entries")
}

// ─── Phase 8: the CRM record ────────────────────────────────────────────────
// The always-on CRM agent runs alongside whichever agent an account chose and
// keeps one record per customer up to date (docs/PRD.md §5, row 10). It needs
// somewhere to write, so the table arrives with it. The screen for managing
// these by hand is Phase 10 — this is the data underneath it.

/// Where a contact has got to with the business.
enum LeadStatus {
  /// Has messaged, nothing established yet.
  NEW
  /// Asked about something specific — a price, a product, a booking.
  INTERESTED
  /// Fits what the business said a good enquiry looks like.
  QUALIFIED
  /// Doesn't fit, or said no.
  NOT_A_FIT
  /// Has bought.
  CUSTOMER
}

/// One contact, as the business's CRM sees them.
///
/// Exactly one row per conversation: the phone number is the only identity
/// WhatsApp gives us, and a thread already means "this business and this
/// contact".
///
/// **Whose writes win.** The CRM agent may fill a field in and may correct its
/// own earlier guess, but anything a person edited in the dashboard is listed
/// in `fieldsEditedByHuman` and the agent leaves it alone from then on
/// (docs/Rules.md §5). `letTheAgentUpdateThis` is the explicit opt-out of that
/// protection, per-lead, for an owner who would rather the agent kept a field
/// current.
model Lead {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// UNIQUE — one lead per thread.
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// The CRM contact behind this lead. Nullable for the same reason as
  /// `Conversation.contactId`.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// Copied from the conversation so the leads table can be read on its own.
  contactPhone String
  name         String?
  email        String?

  status LeadStatus @default(NEW)

  /// 0–100, how promising this enquiry looks against what the owner said a good
  /// one is. Null until there is enough in the thread to judge.
  score Int?

  /// Short labels the agent noticed, e.g. "budget-conscious", "wants delivery".
  tags String[] @default([])

  /// A sentence or two: what this person wants, in plain English.
  summary  String? @db.Text
  /// What the business should do next, if the agent could tell.
  nextStep String? @db.Text

  /// Typed by a person in the dashboard. The agent never writes here.
  notes String? @db.Text

  /// The fields a person has edited by hand. The CRM agent skips every field
  /// named here (docs/Rules.md §5).
  fieldsEditedByHuman   String[] @default([])
  /// Set by the owner to waive that protection for this lead.
  letTheAgentUpdateThis Boolean  @default(false)

  /// When the CRM agent last had something to change.
  lastAgentUpdateAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, updatedAt])
  @@index([businessId, status])
  @@index([contactId])
  @@map("leads")
}

// ─── Phase 12: bulk outreach ────────────────────────────────────────────────
// The riskiest feature in the product. Sent carelessly, a bulk send gets a
// customer's own WhatsApp number banned (docs/PRD.md §7, docs/Rules.md §8), so
// several of the columns below exist purely to make a safety rule enforceable
// rather than merely advisable:
//
//   * `CampaignRecipient.sendAfter` is the throttle. The spacing is written
//     down per recipient when the campaign is scheduled, so it survives a
//     restart and cannot be "sped up" by a retry loop.
//   * `CampaignRecipient.status` is claimed atomically before a send, which is
//     what stops the same person being messaged twice.
//   * `Campaign.warningAcknowledgedAt` records that the QR tier's mandatory
//     ban-risk warning was actually accepted (docs/PRD.md §7.2).
//   * `OptOut` is checked when a campaign is built *and* again as each message
//     goes out, because the two can be days apart.

/// Where a campaign has got to.
enum CampaignStatus {
  /// Being written. Nothing has been scheduled or sent.
  DRAFT
  /// Accepted, and every recipient has a time to go out at.
  SCHEDULED
  /// Some have gone, some haven't.
  SENDING
  /// Every recipient has been dealt with, one way or another.
  SENT
  /// Stopped by the owner. Anything not yet sent never will be.
  CANCELLED
}

/// Where one person's copy of a bulk message has got to.
///
/// Not the same thing as the direction and author on a Message row: this
/// tracks delivery, which only the API tier can actually report on
/// (`supportsDeliveryReceipts` in whatsapp-connectors/capabilities.ts).
enum DeliveryStatus {
  /// Waiting for its turn in the throttle.
  PENDING
  /// Claimed by the sender. A row does not sit here long; if it does, a send
  /// was interrupted.
  SENDING
  /// Handed to WhatsApp. On the QR tier this is as much as is ever known.
  SENT
  /// Meta says it reached the handset.
  DELIVERED
  /// Meta says it was opened.
  READ
  /// They wrote back — the strongest signal a campaign gets.
  REPLIED
  /// It will not be sent. `failureReason` says why, in words the owner can act on.
  FAILED
  /// Deliberately not sent: they opted out between scheduling and their turn.
  SKIPPED
}

/// Whether Meta has approved a template for use on the API tier.
///
/// ChatWise cannot see inside a customer's Meta account, so this records what
/// the customer told us. It is a pre-flight check that gives a clear error
/// early; Meta enforces the real rule at send time regardless.
enum TemplateApproval {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

/// A message a business saves to reuse.
///
/// The two tiers mean genuinely different things by "template". On the QR
/// tier it is ordinary text we fill in and send. On the API tier the words
/// live at Meta under a name they approved, and `metaName`/`metaLanguage` are
/// how we ask for them — `body` is then our copy of what it says, kept so the
/// screen can show a preview and so the opt-out line can be checked.
model MessageTemplate {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// What the owner calls it.
  name     String
  /// The words, with {name}-style placeholders.
  body     String  @db.Text
  /// Which of the starter groups it came from, if any (docs/PRD.md §7.3).
  category String?

  /// API tier only: the template's name and language as registered at Meta.
  metaName     String?
  metaLanguage String?
  approval     TemplateApproval @default(NOT_SUBMITTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The placeholders the body uses, in order — "name", "order_number"… A
  /// body written with Meta's numbered placeholders ({{1}}) lists them as
  /// "1", "2". Filled in on screen before anything is sent.
  variables       String[]  @default([])
  /// Meta's own id for the template, once it has been found there.
  metaTemplateId  String?
  /// Meta's reason, in its own words, when it turned the template down.
  rejectionReason String?
  /// When the approval status was last read back from Meta.
  lastSyncedAt    DateTime?

  campaigns   Campaign[]
  automations AutomationSetting[]

  @@index([businessId, updatedAt])
  @@map("message_templates")
}

/// One bulk send.
model Campaign {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name String

  /// The words as they stood when this was sent — a snapshot, not a reference.
  /// Editing a template afterwards must never change what an already-sent
  /// campaign says it said.
  body String @db.Text

  /// Which template it started from, if any. Kept for the owner's benefit; the
  /// send itself never reads it.
  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  /// API-tier sends go out as an approved template, by name (docs/PRD.md §7.1).
  /// Null on the QR tier, where the text above is sent as it stands.
  metaTemplateName     String?
  metaTemplateLanguage String?

  /// Which connection this went out on, recorded because the rules differ
  /// sharply by tier and a campaign has to be readable back years later.
  tier   ConnectionType
  status CampaignStatus @default(DRAFT)

  /// The gap between messages, in milliseconds. Zero on the API tier.
  throttleMs Int @default(0)

  /// When the QR tier's mandatory ban-risk warning was accepted. Null on a
  /// QR-tier campaign means it must not send (docs/PRD.md §7.2).
  warningAcknowledgedAt DateTime?

  scheduledFor DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A saved segment to send to instead of a hand-picked list. The list is
  /// worked out when the campaign falls due, not when it was written, so a
  /// broadcast scheduled for Friday reaches whoever matches on Friday.
  segmentId       String?
  segment         Segment?  @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  /// When the segment was turned into recipient rows. Null until then; the
  /// sender will not call a segment campaign finished before it is set.
  audienceBuiltAt DateTime?
  /// Only send to contacts who have said yes (OPTED_IN), not merely those who
  /// haven't said no.
  onlyOptedIn     Boolean   @default(false)
  /// Values chosen on screen for the template's placeholders, by name.
  /// Per-contact values ({name}) are filled in per recipient instead.
  variableValues  Json      @default("{}")

  recipients CampaignRecipient[]

  @@index([businessId, createdAt])
  @@index([status])
  @@map("campaigns")
}

/// One person's copy of a bulk message, and what became of it.
///
/// This is also the campaign's contact list: recipients are chosen from the
/// conversations a business already has, which is the only place ChatWise gets
/// a contact from. There is deliberately no separate saved-list table — see
/// docs/Architecture.md §4.
model CampaignRecipient {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// The thread this goes into, so a bulk message appears in the inbox
  /// alongside everything else said to this person.
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  contactPhone String
  contactName  String?

  /// This person's copy, with the placeholders already filled in. Written when
  /// the campaign is scheduled, so what they were sent is never in doubt.
  body String @db.Text

  status DeliveryStatus @default(PENDING)

  /// The earliest this one may go out. The throttle, written down.
  sendAfter DateTime

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  repliedAt   DateTime?

  /// Why it will not be sent, in words the owner can act on.
  failureReason String?

  /// Meta's id for the sent message, which is what a delivery receipt names.
  /// Null on the QR tier, which reports nothing back.
  externalId String? @unique

  createdAt DateTime @default(now())

  /// Nobody is messaged twice by the same campaign, enforced by the database
  /// rather than by whichever code path happens to build the list.
  @@unique([campaignId, contactPhone])
  /// The sender's own question: whose turn is it now?
  @@index([status, sendAfter])
  @@index([conversationId])
  @@map("campaign_recipients")
}

/// Somebody who asked not to be messaged again.
///
/// Checked before every send, on every tier, with no way to override it from
/// the screens (docs/Rules.md §8). Keyed on the phone number rather than on a
/// conversation, so it still applies if that thread is ever deleted.
model OptOut {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  contactPhone String

  /// What they actually wrote, so an owner asking "why is this person
  /// excluded?" gets an answer.
  reason String?

  createdAt DateTime @default(now())

  @@unique([businessId, contactPhone])
  @@index([businessId, createdAt])
  @@map("opt_outs")
}

// ─── Team inbox conveniences ────────────────────────────────────────────────
// Small, single-account features that make the inbox faster to work in day to
// day. They don't touch who is allowed to see what — ChatWise remains one
// account, one inbox — they just save typing and reduce noise.

/// A saved reply a person can drop into any conversation instead of typing it
/// out again — "Thanks, we're looking into it", a standard opening line, etc.
model QuickReply {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// What it's called in the picker, e.g. "Opening line".
  title String
  /// What actually gets sent, placeholders and all — inserted as typed, never
  /// auto-filled, so nothing about the flow the agent already uses to fill in
  /// {name} is duplicated here.
  body  String @db.Text

  /// The order a person arranged them in.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, position])
  @@map("quick_replies")
}

/// One business's working hours and what happens outside them.
///
/// One row per business — an account has one inbox and one schedule for it,
/// the same shape as `AgentInstance` and `WhatsAppConnection` above.
model BusinessHours {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Off by default: every account answers around the clock until an owner
  /// deliberately narrows that.
  enabled Boolean @default(false)

  /// One entry per weekday (0 = Sunday … 6 = Saturday). A day missing from
  /// this map, or present with `closed: true`, is treated as closed. Kept as
  /// JSON rather than seven columns because the shape — "a start and an end
  /// per day" — has no reason to ever need a migration of its own.
  ///
  /// Example: {"1": {"open": "09:00", "close": "18:00"}, "2": {...}}
  schedule Json @default("{}")

  /// What the customer is told when they write in outside these hours. The
  /// agent still stays quiet after this the same way any handover does — this
  /// is a courtesy reply, not a fresh reason to keep answering.
  awayMessage String @default("Thanks for your message! We're outside business hours right now, but we'll get back to you as soon as we're back.") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("business_hours")
}

// ─── Billing (Phase 13) ─────────────────────────────────────────────────────
// What a business is paying for, and whether the payment is currently good.
//
// The amounts are deliberately not here. Prices live in Razorpay and the plan
// list lives in lib/plans.ts; this table records only which plan an account is
// on and what state its payment is in, because those are facts about *this*
// account rather than pricing decisions.

/// The two plans, plus the state of being on neither (see lib/plans.ts).
///
/// **There is one plan per connection tier and nothing else.** The plan a
/// business buys *is* the way it connects to WhatsApp — there is no ladder of
/// sizes within a tier, so `ConnectionType` above and the two plans below are
/// two views of the same choice. `lib/plans.ts` holds what each one includes.
///
/// There is no "number of agents" here on purpose: an account runs one agent on
/// one connection, so that is never a plan question (docs/PRD.md §4).
enum PlanId {
  /// Not a plan anybody can buy — both plans are paid. This is an account with
  /// no live subscription: where a new account starts, and where a cancellation
  /// lands once the period already paid for runs out. It grants nothing
  /// (lib/plans.ts → NO_SUBSCRIPTION_PLAN).
  NONE
  /// Small businesses, on the QR connection. The subscription is the whole
  /// bill; nothing is charged per message.
  SMALL_BUSINESS
  /// Larger businesses, on the official Business API. The subscription plus
  /// Meta's per-conversation charges, which Meta bills to the customer.
  ENTERPRISE
}

/// Where a subscription stands, in our own words rather than Razorpay's.
///
/// Razorpay has more states than this (created, authenticated, active, pending,
/// halted, cancelled, completed, expired) and can add more, so
/// lib/subscription.ts translates theirs into these and treats anything it does
/// not recognise as "not paid up" — the cautious direction to be wrong in.
enum SubscriptionStatus {
  /// Never subscribed. Everyone starts here, and cannot send until they pick a plan.
  NONE
  /// Started but the first payment hasn't gone through yet.
  INCOMPLETE
  ACTIVE
  /// A payment failed. Still theirs, but it needs attention.
  PAST_DUE
  CANCELED
}

/// One row per business, created the first time billing is touched.
model Subscription {
  id         String   @id @default(cuid())
  /// Unique: an account has exactly one subscription, like it has one agent.
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  plan   PlanId             @default(NONE)
  status SubscriptionStatus @default(NONE)

  /// Razorpay's own ids. Not secrets — they are useless without the API key —
  /// but they are never sent to the browser either, because nothing there needs
  /// them (docs/Rules.md §3).
  ///
  /// UNIQUE on both: two businesses sharing one Razorpay subscription would
  /// mean one account's payment silently entitling another's.
  razorpayCustomerId     String? @unique
  razorpaySubscriptionId String? @unique

  /// The paid period Razorpay is currently charging for. Usage is counted
  /// against this when it is set, and against the calendar month when it isn't.
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  /// True once somebody has cancelled but the paid period hasn't run out yet.
  /// They keep everything until `currentPeriodEnd`.
  cancelAtPeriodEnd Boolean @default(false)

  /// Set when a downgrade is waiting for the current period to end, so the
  /// billing screen can say "you move to Starter on the 4th" rather than
  /// pretending nothing is happening.
  pendingPlan PlanId?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

/// Every payment-provider event we have already dealt with.
///
/// Razorpay re-sends an event until it gets a 200, and can send the same one
/// twice regardless. The id is Razorpay's own, and it is the primary key — so a
/// repeat insert fails and the repeat is dropped, exactly the way a re-sent
/// WhatsApp message is dropped by `messages.externalId`.
model BillingEvent {
  /// Razorpay's event id, from the `x-razorpay-event-id` header.
  id   String @id
  type String

  /// Which account it changed, when we could work that out. Handy when
  /// somebody asks why their plan changed at 3am.
  businessId String?

  receivedAt DateTime @default(now())

  @@index([businessId, receivedAt])
  @@map("billing_events")
}

// ─── CRM foundation (2026-09-26) ────────────────────────────────────────────
// Until now a "contact" was spread across three tables: the Conversation (a
// thread with a phone number), the Lead (what the CRM agent learnt) and the
// OptOut list. Shopify customers, imported spreadsheets and payment links all
// need somebody to attach to who may never have messaged at all, so the
// contact becomes a row of its own. Conversations and leads point at it; the
// phone number is still the identity, one contact per number per business.

/// What someone may do inside a business's account.
enum MemberRole {
  /// Runs the account: billing, integrations, team, everything.
  OWNER
  /// Works the inbox and the CRM. Cannot change billing, integrations or the
  /// team.
  AGENT
}

/// A person who works in a business's account.
///
/// The owner has a row here as well as being `Business.userId`, so every
/// "may this person see this?" check is one lookup. A person belongs to one
/// business at a time (userId is UNIQUE), matching one login = one workspace.
model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  role MemberRole @default(AGENT)

  createdAt DateTime @default(now())

  assignedConversations Conversation[] @relation("ConversationAssignee")
  ownedDeals            Deal[]

  @@unique([businessId, userId])
  @@index([businessId])
  @@map("business_members")
}

/// An invitation to join a business's team.
///
/// There is no email service yet (docs/Memory.md), so the owner copies the
/// link and sends it themselves. Only a hash of the token is stored: the link
/// is the secret, and a database leak must not hand out working invitations.
model TeamInvite {
  id          String     @id @default(cuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email       String
  role        MemberRole @default(AGENT)
  tokenHash   String     @unique
  invitedById String
  invitedBy   User       @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime   @default(now())

  @@index([businessId])
  @@map("team_invites")
}

/// Whether a contact has agreed to hear from the business.
enum OptInStatus {
  /// We have no record either way. Transactional messages (order updates) are
  /// allowed; broadcasts can be limited to OPTED_IN contacts per campaign.
  PENDING
  OPTED_IN
  /// Said STOP or was opted out by hand. Nothing automated reaches them.
  OPTED_OUT
}

/// One person a business knows, whether or not they have messaged yet.
model Contact {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Digits only, international format — the same shape as
  /// `Conversation.contactPhone`, which is what dedupes the two.
  phone String
  name  String?
  email String?

  /// The language they write in, as a short code ("en", "hi", "es"), detected
  /// from their messages. Used for replies and for filtering broadcasts.
  language String?

  /// Lifetime spend across paid orders and paid payment links, in `currency`.
  /// Recomputed from those rows rather than incremented, so a re-delivered
  /// webhook can never count an order twice (lib/contacts.ts).
  totalSpent  Decimal   @default(0) @db.Decimal(14, 2)
  currency    String?
  orderCount  Int       @default(0)
  lastOrderAt DateTime?

  optInStatus OptInStatus @default(PENDING)
  /// Where the current consent state came from ("whatsapp: replied STOP",
  /// "shopify checkout", "import", "dashboard").
  optInSource String?
  /// When it last changed.
  optInAt     DateTime?

  shopifyCustomerId String?
  /// The import that created this contact, so a bad import can be undone.
  importBatchId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  leads         Lead[]
  tags          ContactTag[]
  consentEvents ConsentEvent[]
  deals         Deal[]
  orders        Order[]
  checkouts     ShopifyCheckout[]
  payments      Payment[]
  bookings      Booking[]

  @@unique([businessId, phone])
  @@index([businessId, createdAt])
  @@index([businessId, shopifyCustomerId])
  @@index([businessId, optInStatus])
  @@index([importBatchId])
  @@map("contacts")
}

/// A label that can be put on contacts, e.g. "VIP" or "abandoner".
model Tag {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())

  contacts ContactTag[]
  rules    TagRule[]

  @@unique([businessId, name])
  @@map("tags")
}

/// How a tag ended up on a contact. Rule-applied tags are removed again when
/// the rule stops matching; tags a person added are never touched by a rule.
enum TagSource {
  MANUAL
  RULE
  IMPORT
  SHOPIFY
}

/// Which contacts carry which tags (many-to-many).
model ContactTag {
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  businessId String
  source     TagSource @default(MANUAL)
  createdAt  DateTime  @default(now())

  @@id([contactId, tagId])
  @@index([businessId])
  @@index([tagId])
  @@map("contact_tags")
}

/// The audit log of every consent change. Never updated, never deleted except
/// with the contact itself (a GDPR erasure).
model ConsentEvent {
  id          String       @id @default(cuid())
  businessId  String
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  fromStatus  OptInStatus?
  toStatus    OptInStatus
  /// Where it came from, in words: "whatsapp", "dashboard", "import", …
  source      String
  /// What exactly happened — the word they replied, the import id, etc.
  detail      String?
  /// The team member who made the change, when a person did.
  actorUserId String?
  createdAt   DateTime     @default(now())

  @@index([businessId, createdAt])
  @@index([contactId, createdAt])
  @@map("consent_events")
}

/// Where a background job has got to.
enum JobStatus {
  PENDING
  RUNNING
  DONE
  /// Ran out of attempts. Shown to the owner on the Integrations screen.
  FAILED
  CANCELLED
}

/// Work that must not happen inside a webhook request.
///
/// Shopify, Razorpay, Stripe and Calendly all give a webhook a few seconds to
/// answer before assuming we are down, so the webhook only writes a row here
/// and returns. jobs/pending-job-runner.ts, on the always-on host, picks rows
/// up by `runAt` and does the slow part — including every WhatsApp send.
///
/// A queue in Postgres rather than BullMQ for the same reason as the campaign
/// sender (jobs/README.md): the schedule is a fact the database already owns,
/// and "run this in an hour unless the cart converted" is a row with a time on
/// it that survives restarts and can be cancelled with an UPDATE.
model PendingJob {
  id          String    @id @default(cuid())
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Set for Shopify work, so uninstalling a store cancels everything it
  /// queued in one statement.
  shopId      String?
  jobType     String
  payload     Json      @default("{}")
  runAt       DateTime  @default(now())
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?
  /// When set, a second job with the same key is not created — how a
  /// re-delivered webhook avoids queueing the same message twice.
  dedupeKey   String?   @unique
  lockedAt    DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([businessId, status])
  @@index([shopId, status])
  @@map("pending_jobs")
}

// ─── Segments, rules, deals, team inbox (2026-09-26) ────────────────────────

/// A saved filter over contacts — tags, fields, dates — reused by broadcasts,
/// exports and auto-tag rules. The filter's shape is documented and checked in
/// lib/segments.ts; nothing else writes it.
model Segment {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  filter     Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaigns        Campaign[]
  scheduledExports ScheduledExport[]

  @@unique([businessId, name])
  @@map("segments")
}

/// "Contacts matching this filter get this tag." Re-run after every order and
/// once a day; a contact who stops matching loses the tag again, unless a
/// person put it on them.
model TagRule {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  name       String
  /// Same shape as `Segment.filter`.
  filter     Json      @default("{}")
  enabled    Boolean   @default(true)
  lastRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([businessId])
  @@map("tag_rules")
}

enum ConversationPriority {
  NORMAL
  HIGH
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

/// A note one team member leaves for the others on a thread. Never sent to
/// the customer. `@name` mentions notify the people named.
model ConversationNote {
  id               String       @id @default(cuid())
  businessId       String
  business         Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId         String
  body             String       @db.Text
  mentionedUserIds String[]     @default([])
  createdAt        DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([businessId])
  @@map("conversation_notes")
}

enum NotificationKind {
  MENTION
  ASSIGNED
  URGENT
}

/// Something a team member should look at: they were mentioned, or a thread
/// was handed to them.
model Notification {
  id             String           @id @default(cuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String
  kind           NotificationKind
  conversationId String?
  text           String
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([userId, readAt])
  @@index([businessId])
  @@map("notifications")
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

/// A potential sale, moved across the pipeline board.
model Deal {
  id            String          @id @default(cuid())
  businessId    String
  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title         String
  stage         DealStage       @default(LEAD)
  value         Decimal         @default(0) @db.Decimal(14, 2)
  currency      String          @default("INR")
  expectedClose DateTime?
  ownerId       String?
  owner         BusinessMember? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  /// Order within its column on the board.
  position      Float           @default(0)
  closedAt      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  activities DealActivity[]

  @@index([businessId, stage, position])
  @@index([contactId])
  @@map("deals")
}

enum DealActivityKind {
  CREATED
  STAGE_CHANGED
  VALUE_CHANGED
  OWNER_CHANGED
  NOTE
}

/// Everything that happened to a deal, oldest first.
model DealActivity {
  id          String           @id @default(cuid())
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dealId      String
  deal        Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  actorUserId String?
  kind        DealActivityKind
  fromStage   DealStage?
  toStage     DealStage?
  note        String?          @db.Text
  createdAt   DateTime         @default(now())

  @@index([dealId, createdAt])
  @@index([businessId])
  @@map("deal_activities")
}

// ─── Integrations (2026-09-26) ──────────────────────────────────────────────

/// Every webhook we have already acted on, from any provider.
///
/// Shopify, Razorpay, Stripe and Calendly all retry deliveries and can send
/// the same one twice regardless. The provider's own event id is unique here,
/// so the second insert fails and the repeat is dropped — the same trick as
/// `BillingEvent` and `Message.externalId`.
model IntegrationEvent {
  id         String   @id @default(cuid())
  provider   String
  externalId String
  businessId String?
  topic      String
  receivedAt DateTime @default(now())

  @@unique([provider, externalId])
  @@index([businessId, receivedAt])
  @@map("integration_events")
}

/// A Shopify store connected to a business. One store per business.
model Shop {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// "example.myshopify.com" — Shopify's permanent name for the store.
  shopDomain  String @unique
  /// The Admin API token, encrypted (lib/encryption.ts). Never logged, never
  /// sent to a browser.
  accessToken Bytes
  scopes      String

  active         Boolean   @default(true)
  installedAt    DateTime  @default(now())
  uninstalledAt  DateTime?
  /// When the order/checkout/customer webhooks were last registered, and
  /// what went wrong if they could not be.
  webhooksAt     DateTime?
  webhookError   String?
  /// Progress of the one-off import of past customers, orders and products.
  backfillStatus String?
  backfilledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  checkouts ShopifyCheckout[]

  @@map("shops")
}

enum OrderStatus {
  /// Placed, not yet paid.
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// An order, from Shopify or tied to a payment link.
model Order {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shopId     String?
  shop       Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  shopifyOrderId String?
  /// What the customer sees, e.g. "#1042".
  orderNumber    String?
  status         OrderStatus @default(PENDING)
  total          Decimal     @default(0) @db.Decimal(14, 2)
  currency       String      @default("INR")
  trackingUrl    String?
  trackingNumber String?
  checkoutToken  String?

  placedAt    DateTime  @default(now())
  paidAt      DateTime?
  fulfilledAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments Payment[]

  @@unique([shopId, shopifyOrderId])
  @@index([businessId, placedAt])
  @@index([contactId])
  @@map("orders")
}

/// A Shopify checkout, kept so an abandoned one can be followed up.
model ShopifyCheckout {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shopId        String
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  checkoutToken String
  phone         String?
  email         String?
  total         Decimal   @default(0) @db.Decimal(14, 2)
  currency      String    @default("INR")
  /// Shopify's link back into this exact cart.
  recoveryUrl   String?
  /// Set when an order came from this checkout — the abandoned-cart message
  /// checks this and stays quiet.
  convertedAt   DateTime?
  remindedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([shopId, checkoutToken])
  @@index([businessId, createdAt])
  @@index([contactId])
  @@map("shopify_checkouts")
}

/// What Shopify asked of us under GDPR, and what we did about it.
model ComplianceRequest {
  id          String    @id @default(cuid())
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  shopDomain  String
  /// customers/data_request, customers/redact or shop/redact.
  topic       String
  /// For a data request: what we hold on that customer, for the merchant to
  /// pass on. Empty for the two erasure topics.
  result      Json?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([businessId, createdAt])
  @@map("compliance_requests")
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
}

/// A business's own Razorpay or Stripe account, used to take payment from its
/// customers — nothing to do with ChatWise's own subscription billing, which
/// stays in lib/razorpay.ts on the platform's account.
model PaymentAccount {
  id         String          @id @default(cuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider   PaymentProvider

  /// Razorpay's key id. Not a secret on its own, but kept server-side anyway.
  keyId            String?
  /// Razorpay key secret or Stripe secret key, encrypted.
  secretKey        Bytes
  /// The webhook signing secret the business copied from the provider,
  /// encrypted. Without it every webhook is refused.
  webhookSecret    Bytes?
  /// Part of this business's own webhook address, so an event names the
  /// account it belongs to before its signature is checked.
  webhookPathToken String  @unique
  currency         String  @default("INR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, provider])
  @@map("payment_accounts")
}

enum PaymentStatus {
  /// A link exists and nobody has paid it yet.
  CREATED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  EXPIRED
  CANCELLED
}

/// One payment link sent to a contact, and what became of it.
model Payment {
  id         String          @id @default(cuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  contactId  String?
  contact    Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  provider   PaymentProvider

  /// Razorpay payment link id, or Stripe Checkout Session id.
  providerLinkId    String?
  /// The payment itself once there is one: Razorpay pay_…, Stripe pi_….
  providerPaymentId String?
  linkUrl           String?

  /// In the currency's smallest unit (paise, cents), which is how both
  /// providers count and why this is an integer rather than a decimal.
  amount         Int
  currency       String        @default("INR")
  refundedAmount Int           @default(0)
  status         PaymentStatus @default(CREATED)
  description    String
  /// An invoice number or any reference the business wants on the receipt.
  reference      String?

  /// The unguessable part of the public receipt address (/receipts/<token>).
  receiptToken String    @unique
  /// The failed payment this one was created to retry, if any.
  retryOfId    String?
  createdById  String?
  paidAt       DateTime?
  failedAt     DateTime?
  refundedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([provider, providerLinkId])
  @@index([businessId, createdAt])
  @@index([provider, providerPaymentId])
  @@index([contactId])
  @@index([orderId])
  @@map("payments")
}

/// The automated WhatsApp messages an owner can switch on.
enum AutomationKind {
  ORDER_CONFIRMED
  ORDER_PAID
  ORDER_SHIPPED
  ABANDONED_CART
  PAYMENT_LINK
  PAYMENT_RECEIPT
  PAYMENT_RETRY
  REFUND_CONFIRMED
  BOOKING_INVITE
  BOOKING_CONFIRMED
  BOOKING_REMINDER
}

/// Whether one automated message is on, and what it says.
///
/// `body` is used on the QR connection and inside WhatsApp's 24-hour reply
/// window. Outside that window the Business API only allows an approved
/// template, so API-tier accounts pick one in `templateId`; without it the
/// message is sent only when the window is open.
model AutomationSetting {
  id           String           @id @default(cuid())
  businessId   String
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind         AutomationKind
  enabled      Boolean          @default(false)
  body         String           @db.Text
  templateId   String?
  template     MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// For timed messages (abandoned cart), how long to wait.
  delayMinutes Int?
  updatedAt    DateTime         @updatedAt

  @@unique([businessId, kind])
  @@map("automation_settings")
}

/// A Google account connected for Sheets (and later Calendar).
///
/// Separate from the Google *sign-in* in `Account`: signing in asks only for
/// who you are, and a business's spreadsheet access should not depend on which
/// team member happens to log in with Google.
model GoogleConnection {
  id            String   @id @default(cuid())
  businessId    String   @unique
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  connectedById String
  googleEmail   String?
  /// Encrypted. The only long-lived Google credential we keep.
  refreshToken  Bytes
  scopes        String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("google_connections")
}

enum ExportFrequency {
  DAILY
  WEEKLY
}

/// A contact export to Google Sheets that runs on its own.
model ScheduledExport {
  id            String          @id @default(cuid())
  businessId    String
  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  spreadsheetId String
  sheetName     String          @default("Contacts")
  segmentId     String?
  segment       Segment?        @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  frequency     ExportFrequency
  /// REPLACE rewrites the sheet each time; APPEND adds rows below.
  mode          String          @default("REPLACE")
  enabled       Boolean         @default(true)
  nextRunAt     DateTime
  lastRunAt     DateTime?
  lastError     String?
  createdAt     DateTime        @default(now())

  @@index([enabled, nextRunAt])
  @@index([businessId])
  @@map("scheduled_exports")
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
  ROLLED_BACK
}

/// One import of contacts, so a bad one can be found and undone.
model ImportBatch {
  id           String       @id @default(cuid())
  businessId   String
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  source       String
  sourceRef    String?
  rowCount     Int          @default(0)
  createdCount Int          @default(0)
  updatedCount Int          @default(0)
  errorCount   Int          @default(0)
  /// The first few hundred rows that could not be imported, and why.
  errors       Json         @default("[]")
  status       ImportStatus @default(PROCESSING)
  createdById  String?
  createdAt    DateTime     @default(now())
  completedAt  DateTime?
  rolledBackAt DateTime?

  @@index([businessId, createdAt])
  @@map("import_batches")
}

/// A business's Calendly account.
model CalendlyConnection {
  id               String   @id @default(cuid())
  businessId       String   @unique
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// The page customers book on. All that is needed to send the link.
  bookingUrl       String
  /// A Calendly personal access token, encrypted. Needed only to register the
  /// webhook that tells us when somebody books.
  accessToken      Bytes?
  userUri          String?
  organizationUri  String?
  webhookUri       String?
  /// The key Calendly signs webhooks with, encrypted. We choose it.
  signingKey       Bytes?
  webhookPathToken String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("calendly_connections")
}

enum BookingProvider {
  CALENDLY
  GOOGLE
}

enum BookingStatus {
  BOOKED
  CANCELED
}

/// A meeting a contact booked.
model Booking {
  id                String          @id @default(cuid())
  businessId        String
  business          Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactId         String?
  contact           Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  provider          BookingProvider
  /// Calendly's invitee URI — unique per booking.
  providerEventId   String
  eventName         String?
  startTime         DateTime
  endTime           DateTime?
  status            BookingStatus   @default(BOOKED)
  inviteeName       String?
  inviteeEmail      String?
  inviteePhone      String?
  cancelUrl         String?
  rescheduleUrl     String?
  /// Set the moment each reminder is claimed, so no reminder goes twice.
  reminder24hSentAt DateTime?
  reminder1hSentAt  DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([businessId, provider, providerEventId])
  @@index([businessId, startTime])
  @@index([status, startTime])
  @@index([contactId])
  @@map("bookings")
}

enum ProductSource {
  SHOPIFY
  MANUAL
}

/// A product the agents may talk about, with an embedding for search.
///
/// The Sales and Personal Shopper agents are given the few products closest
/// to what the customer asked, with live price and stock, rather than being
/// left to guess (docs/Rules.md §5 — no fabricated business information).
model Product {
  id          String        @id @default(cuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  source      ProductSource
  /// Shopify's product id, or a SKU/handle for manually added products.
  externalId  String
  title       String
  description String        @default("") @db.Text
  vendor      String?
  productType String?
  tags        String[]      @default([])
  priceMin    Decimal?      @db.Decimal(14, 2)
  priceMax    Decimal?      @db.Decimal(14, 2)
  currency    String?
  /// Total units in stock across variants, when the store tracks it.
  inventory   Int?
  available   Boolean       @default(true)
  url         String?
  imageUrl    String?

  /// pgvector column, 768 dimensions (Gemini text embeddings). Written and
  /// read with raw SQL in lib/catalog.ts, since Prisma cannot express it.
  embedding    Unsupported("vector(768)")?
  /// A hash of the text that was embedded, so unchanged products aren't
  /// re-embedded on every sync.
  embeddedHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, source, externalId])
  @@index([businessId])
  @@map("products")
}
