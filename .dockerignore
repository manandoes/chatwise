# Anything the Next.js app needs but the worker container never touches, plus
# anything that must be regenerated fresh inside the container rather than
# copied from whoever's machine is running `docker build`.

node_modules
.next
.git

# Regenerated by `npm ci`'s postinstall (`prisma generate`) *inside* the
# container. Copying a host-built copy in would carry the host's platform in
# its query-engine binary (e.g. Windows) instead of the container's (Debian).
lib/generated

.env*
!.env.example
*.log
tmp/
temp/
*.tsbuildinfo

# WhatsApp session data — never belongs in an image (docs/Rules.md §3).
.whatsapp-sessions*/
.wwebjs_auth/
.wwebjs_cache/

# Tooling irrelevant to the worker process.
.claude/
.agents/
.windsurf/
.codegraph/
docs/
