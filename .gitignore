# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# env files — never commit real secrets (docs/Rules.md §3).
# .env.example is the documented, safe-to-commit template.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated Prisma client (recreated by `npx prisma generate`)
/lib/generated

# WhatsApp Web session data. These are effectively keys to customers' WhatsApp
# accounts — they must never be committed (docs/Rules.md §3).
.whatsapp-sessions*/
.wwebjs_auth/
.wwebjs_cache/

# next.js / build caches
.turbo/
.swc/
.eslintcache

# local Redis snapshots (BullMQ dev queue)
dump.rdb

# logs
*.log
logs/

# editors
.vscode/
.idea/
*.swp
*.swo
*~

# os
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# vendored Prisma skill docs. Each agent tool installs its own byte-identical
# copy; skills-lock.json is the manifest they are reinstalled from, so the
# docs themselves do not belong in the repo.
.agents/skills/
.claude/skills/
.windsurf/skills/

# local agent/tool settings — machine-specific.
.claude/settings.local.json
.claude/*.local.json
.mcp.local.json

# scratch
tmp/
temp/
