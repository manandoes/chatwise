# ChatWise — environment variables
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed (docs/Rules.md §3). No key, token or connection
# string ever belongs in the source code itself.
#
# Only variables prefixed NEXT_PUBLIC_ are visible to the browser. Everything
# else stays on the server. Never move a secret behind a NEXT_PUBLIC_ name.
#
# Each variable notes the phase that first needs it, so you do not have to fill
# in the whole file before you can run the app.


# ─── Phase 0 — Database (Supabase) ────────────────────────────────────────────
#
# Supabase gives you two connection strings for the same database. Find them in
# your Supabase project under Settings → Database → Connection string.
#
#   DATABASE_URL  the POOLED one (port 6543). The running app uses this, because
#                 serverless hosting opens and drops connections constantly and
#                 the pooler is what keeps that from exhausting the database.
#   DIRECT_URL    the DIRECT one (port 5432). Only the migration commands use
#                 this — schema changes cannot run through the pooler.
#
# Keep the `?pgbouncer=true&connection_limit=1` on the pooled URL.

DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Running against a plain local PostgreSQL instead? Set DATABASE_URL to it and
# leave DIRECT_URL blank — the migration tools fall back to DATABASE_URL.
# Local example: postgresql://postgres:postgres@localhost:5432/chatwise?schema=public

# Optional. `npm run db:migrate` rehearses each change on a scratch "shadow"
# database first. Normally it creates one automatically, but that needs
# permission to create databases, which hosted providers (Supabase included)
# often don't grant. If migrations fail complaining about the shadow database,
# create a second empty database and point this at it.
SHADOW_DATABASE_URL=""


# ─── Phase 1 — Login & accounts (NextAuth) ────────────────────────────────────

# Secret used to sign the login cookie. REQUIRED — logging in fails without it.
# Generate one with:  openssl rand -base64 32
# Use a different value in production from the one you use locally. Changing it
# logs everybody out.
AUTH_SECRET=""

# The full public URL of the app. Only needed when the host doesn't provide it
# automatically (Vercel does). http://localhost:3000 while developing.
AUTH_URL="http://localhost:3000"

# Set to true only if you deploy somewhere that isn't Vercel and sign-in
# redirects come back to the wrong address.
# AUTH_TRUST_HOST="true"

# Google sign-in. Optional — leave both blank and the "Continue with Google"
# button simply doesn't appear.
# Create them in the Google Cloud console under
# APIs & Services → Credentials → OAuth client ID (Web application), and add
# this authorised redirect URI:
#   http://localhost:3000/api/auth/callback/google   (and the same on your real domain)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# ─── Phase 5 — QR tier: WhatsApp QR connection ──────────────────────────────

# Redis, used for the job queue and for tracking each customer's live QR session.
#
# LEAVE THIS BLANK if you don't have a Redis yet. The app checks whether Redis
# actually answers, not just whether this is filled in, so a wrong or dead URL
# shows "the service isn't running" rather than hanging — but blank is clearer.
#
# Free options: Upstash, Railway, or locally: docker run -p 6379:6379 redis
REDIS_URL=""

# Where the WhatsApp session workers store each customer's browser profile
# while running. Only used on the worker host.
WHATSAPP_SESSION_PATH="./.whatsapp-sessions"

# Path to a Chrome or Chromium the workers can drive. Without this they look for
# one Puppeteer downloaded; setting it lets you use a browser that is already
# installed. Only needed on the worker host.
# Windows: C:/Program Files/Google/Chrome/Application/chrome.exe
# Debian:  /usr/bin/chromium
CHROME_PATH=""

# 32-byte key used to encrypt WhatsApp session data and API credentials before
# they are stored in the database (docs/Rules.md §3).
# Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=""


# ─── Phase 6 — API tier: WhatsApp Business Cloud API ─────────────────────────

# NOTHING GOES HERE PER CUSTOMER.
#
# Each customer brings their own Meta app, and enters its phone number ID,
# access token and app secret in the dashboard. Those are stored encrypted,
# per account — there is no platform-wide Meta app secret and no platform-wide
# webhook verify token.
#
# Each customer also gets their own webhook address, of the form
#   https://your-domain/api/whatsapp/business-api/webhook/<their-own-token>
# which the Connect WhatsApp screen shows them, along with a verify token we
# generate for them to paste into Meta.
#
# QR-tier customers need none of this — that route never touches Meta.

# Which version of Meta's Graph API to call. Meta retires old versions on its
# own schedule; if calls start failing with a version error, raise this.
META_GRAPH_API_VERSION="v21.0"


# ─── Phase 7 — The AI that powers the bots ────────────────────────────────────

# API key for Google Gemini, the model the agents in /bots run on.
# Create one at https://aistudio.google.com/apikey
#
# This is the platform's own key — the default every account runs on. A customer
# can bring their own instead, from Settings in the dashboard; theirs is stored
# encrypted against their business and overrides this one for their agents.
#
# With neither this nor a key of their own, an account's agent cannot answer: a
# message still arrives, is recorded, and is handed to a person — it is just
# never replied to automatically. Both the web app and the QR-tier worker host
# need this.
GEMINI_API_KEY=""

# Which model the agents run on. Optional — there is a sensible default in
# lib/ai-client.ts (gemini-3.8-flash). Set it to try a faster or cheaper model
# without a code change.
GEMINI_MODEL=""

# Where to reach the model provider. Optional — leave blank for the real thing.
# Set it to point at a gateway, a regional endpoint, or a stub while testing.
GEMINI_BASE_URL=""



# ─── Later — File storage (knowledge base uploads, catalog images) ──────────

# Not used yet. The Phase 7 knowledge base is typed-in text only; uploads and
# product catalogues arrive with the agents that need them (docs/Phases.md).
# Any S3-compatible storage (AWS S3, Cloudflare R2, …).
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""


# ─── Phase 13 — Billing ───────────────────────────────────────────────────────

# Razorpay, chosen by the product owner on 2026-09-05 (this replaced the earlier
# assumption of Stripe). Everything below comes from the Razorpay dashboard.
#
# Leave these blank and the app runs perfectly well with payments switched off:
# nothing is limited, and the Billing screen says so plainly rather than showing
# buttons that would fail.

# Settings → API Keys. The secret is a real secret — never send it to a browser.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Settings → Webhooks. Point the webhook at https://<your-domain>/api/billing/webhook
# and subscribe it to the `subscription.*` events. This secret is what proves an
# incoming event really came from Razorpay; without it every webhook is refused.
RAZORPAY_WEBHOOK_SECRET=""

# Subscriptions → Plans. There are two plans, one per connection tier, and both
# are paid — so create two monthly Razorpay plans at the prices in lib/plans.ts
# (₹999 for Small Business, ₹1,499 for Enterprise) and paste each plan id here.
# The ids differ between your test and live Razorpay accounts, which is exactly
# why they live here rather than in the code.
#
# Nothing here covers Meta's per-conversation charges on the Business API: Meta
# bills the customer directly for those, and that money never touches Razorpay
# or us.
RAZORPAY_PLAN_ID_SMALL_BUSINESS=""
RAZORPAY_PLAN_ID_ENTERPRISE=""

# Optional: pin a Razorpay API version. Leave blank to use your account's own.
RAZORPAY_API_VERSION=""


# ─── 2026-09 — CRM & integrations ─────────────────────────────────────────────
#
# The public address of this app, with no trailing slash. Every OAuth redirect
# and webhook address handed to Shopify, Google, Calendly, Razorpay or Stripe is
# built on it, so in production it must be the real https:// domain. Falls back
# to AUTH_URL when blank.
APP_URL=""

# Lets a scheduler (Vercel Cron, Cloud Scheduler…) run background jobs by
# calling GET /api/cron/jobs with "Authorization: Bearer <this value>". Not
# needed when the always-on WhatsApp host is running — it runs them itself.
# Generate one with: openssl rand -base64 32
CRON_SECRET=""

# Every integration is OFF until its flag is "true". Most also need their keys
# below. A deploy of this code changes nothing for a live account until the
# owner switches something on.
FEATURE_SHOPIFY=""
FEATURE_PAYMENT_LINKS=""
FEATURE_GOOGLE_SHEETS=""
FEATURE_CALENDLY=""
FEATURE_AI_INSIGHTS=""
FEATURE_CATALOG_SEARCH=""

# Shopify — from your app in the Shopify Partner dashboard (Apps → your app →
# Client credentials). In the app's configuration:
#   * App URL:        https://<your-domain>/dashboard/integrations
#   * Redirect URL:   https://<your-domain>/api/shopify/callback
#   * Compliance webhooks (customers/data_request, customers/redact,
#     shop/redact): https://<your-domain>/api/shopify/webhooks
# The order/checkout/customer/product webhooks are registered automatically
# when a store connects. Reading customers' phone numbers needs Shopify's
# "protected customer data" access approved for the app.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
# Optional: pin the Admin API version (defaults to the one in
# integrations/shopify/client.ts). Shopify retires versions quarterly.
SHOPIFY_API_VERSION=""

# Optional: the model used to index products for search (1 embedding per
# product). Defaults to gemini-embedding-001 at 768 dimensions — the size is
# fixed by the database column, so a different model must support 768.
GEMINI_EMBEDDING_MODEL=""
